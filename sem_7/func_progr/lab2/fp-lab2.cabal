cabal-version:      2.4
name:               fp-lab2
version:            1.0.0
synopsis:           Паралельне дискретне логарифмування
build-type:         Simple

executable discrete-log
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    ModArith, DiscreteLog
    build-depends:    base >=4.14 && <5,
                      containers
    default-language: Haskell2010
    ghc-options:      -O2 -Wall -threaded -rtsopts "-with-rtsopts=-N"
